# Copy to .env. Fill values from Supabase > Project Settings > API Keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
# For demo bootstrap only. Do NOT use real customer credentials.
DEMO_PASSWORD=

# OPTIONAL: Music SSO integration. Keep all three unset until the Vercel
# Music backend supports secure PKCE + state validation and tenant sessions.
# These are examples, not real deployed endpoints or credentials.
# MUSIC_SSO_START_URL=https://music.example.test/api/sso/start
# MUSIC_SSO_CALLBACK_URL=https://music.example.test/api/sso/callback
# MUSIC_SSO_CLIENT_SECRET=REPLACE_WITH_RANDOM_SERVER_ONLY_64_CHAR_SECRET
