{
  "name": "vsph-control-center-supabase",
  "version": "2.0.0",
  "private": true,
  "description": "VSPH multi-tenant product portal with Supabase Auth and managed PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "format:check": "prettier --check \"docs/architecture/*.md\" \"docs/roadmap/*.md\" \"docs/operations/*.md\"",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:db:local": "node scripts/local-database.mjs",
    "test:e2e": "playwright test",
    "test:e2e:db": "node scripts/local-database.mjs --e2e",
    "invitations:dispatch": "node scripts/dispatch-invitations.js",
    "github:sync": "node scripts/sync-github.js",
    "notifications:dispatch": "node scripts/dispatch-project-notifications.js",
    "check:migrations": "node scripts/staging-readiness.js --manifest-only",
    "staging:inspect": "node scripts/staging-readiness.js",
    "github:verify": "node scripts/verify-github.js",
    "test:restore:ci": "node scripts/rehearse-restore.mjs",
    "config:inspect": "node scripts/inspect-config.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.79.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.11",
    "pg": "^8.23.1",
    "prettier": "^3.9.10"
  }
}
